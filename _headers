/* Global Security Headers (2026 Best Practices) */
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://widgets.leadconnectorhq.com https://link.msgsndr.com https://static.cloudflareinsights.com 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https:; form-action 'self' https://*.leadconnectorhq.com https://*.msgsndr.com; frame-ancestors 'none'; frame-src https://api.leadconnectorhq.com https://link.msgsndr.com https://*.leadconnectorhq.com https://*.msgsndr.com https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'none'; upgrade-insecure-requests; media-src 'self' data: https:
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  Referrer-Policy: no-referrer-when-downgrade
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin
  X-Permitted-Cross-Domain-Policies: none
  X-Download-Options: noopen
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=0, must-revalidate

/* HTML Pages - No Cache */
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/pages/*
  Cache-Control: public, max-age=0, must-revalidate

/* CSS - Aggressive Caching with Versioning */
/css/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/* JavaScript - Aggressive Caching with Versioning */
/js/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/* Images - Long-term Caching */
/assets/*
  Cache-Control: public, max-age=2592000, immutable
  X-Content-Type-Options: nosniff

/* Fonts - Long-term Caching */
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/* Icons - Long-term Caching */
/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
